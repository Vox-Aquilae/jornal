---
import Emblema from './Emblema.astro';
import { u, temValor } from '../lib/site';
interface Props { imagem?: string | null; alt?: string | null; rotulo: string; proporcao?: string; prioridade?: boolean }
const { imagem, alt, rotulo, proporcao = '3 / 2', prioridade = false } = Astro.props;
---
{temValor(imagem) ? (
  <img class="capa" src={u(imagem!)} alt={alt ?? ''} loading={prioridade ? 'eager' : 'lazy'} decoding="async" style={`aspect-ratio: ${proporcao}`} />
) : (
  <div class="capa capa-tipo" style={`aspect-ratio: ${proporcao}`} aria-hidden="true">
    <Emblema class="marca-agua" arcos={false} />
    <span class="rotulo">{rotulo}</span>
  </div>
)}

<style>
  .capa { width: 100%; max-width: 100%; object-fit: cover; border-radius: var(--raio); background: var(--papel-2); }
  .capa-tipo { position: relative; overflow: hidden; display: flex; align-items: flex-end; padding: 6%; background: var(--azul); color: #fff; }
  .capa-tipo :global(.marca-agua) { position: absolute; right: -6%; bottom: -16%; width: 58%; color: rgba(255,255,255,.1); }
  .rotulo { position: relative; font-family: var(--serif); font-style: italic; font-size: clamp(18px, 2.2vw, 26px); line-height: 1.1; }
  .rotulo::before { content: ''; display: block; width: 32px; height: 3px; background: var(--vermelho); margin-bottom: 10px; }
</style>
