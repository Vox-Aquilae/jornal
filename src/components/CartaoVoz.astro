---
import type { CollectionEntry } from 'astro:content';
import { u, PAPEIS, temValor } from '../lib/site';
interface Props { v: CollectionEntry<'vozes'>; escuro?: boolean }
const { v, escuro = false } = Astro.props;
const d = v.data;
const iniciais = d.nome.replace(/[\[\]]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
---
<figure class:list={['voz', `papel-${d.papel}`, { escuro }]} data-papel={d.papel}>
  <div class="cima">
    <span class="papel">{PAPEIS[d.papel].nome}</span>
    {d.exemplo && <span class="selo-exemplo">Exemplo</span>}
  </div>
  <blockquote>{d.citacao}</blockquote>
  {v.body && v.body.trim() && (
    <details>
      <summary>Ler testemunho completo</summary>
      <div class="completo" set:html={v.rendered?.html ?? ''} />
    </details>
  )}
  <figcaption>
    {temValor(d.foto)
      ? <img src={u(d.foto!)} alt="" loading="lazy" />
      : <span class="avatar" aria-hidden="true">{iniciais}</span>}
    <span><strong>{d.nome}</strong>{temValor(d.detalhe) && <span class="detalhe">{d.detalhe}</span>}</span>
  </figcaption>
</figure>

<style>
  .voz {
    margin: 0; display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 6px;
    background: #fff; border: 1px solid var(--rule); position: relative; height: 100%;
    --acento: var(--navy);
  }
  .papel-familia { --acento: #8a6516; }
  .papel-professor { --acento: #1f5a48; }
  .papel-antigo-aluno { --acento: #7a3b2e; }
  blockquote::before { content: '«'; color: var(--acento); margin-right: 2px; }
  blockquote::after { content: '»'; color: var(--acento); margin-left: 2px; }
  .cima { display: flex; gap: 10px; align-items: center; }
  .papel { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--acento); }
  .papel::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--acento); margin-right: 8px; vertical-align: 1px; }
  blockquote { margin: 0; font-family: var(--serif); font-size: 21px; line-height: 1.4; color: var(--navy); flex: 1; }
  details { font-size: 15px; }
  summary { cursor: pointer; font-weight: 600; color: var(--acento); min-height: 32px; }
  .completo { margin-top: 10px; color: #3b4150; }
  figcaption { display: flex; align-items: center; gap: 12px; font-size: 14.5px; border-top: 1px solid var(--rule); padding-top: 16px; }
  figcaption strong { display: block; color: var(--ink); }
  .detalhe { color: var(--muted); }
  figcaption img, .avatar { width: 44px; height: 44px; border-radius: 50%; flex: none; object-fit: cover; }
  .avatar { display: grid; place-items: center; background: var(--acento); color: #fff; font-weight: 700; font-size: 15px; letter-spacing: .04em; }

  .escuro { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.14); --acento: var(--gold-claro); }
  .escuro.papel-professor { --acento: #8fc7b0; }
  .escuro.papel-antigo-aluno { --acento: #e8a593; }
  .escuro.papel-aluno { --acento: #a9c3ec; }
  .escuro blockquote { color: #fff; }
  .escuro figcaption { border-color: rgba(255,255,255,.14); }
  .escuro figcaption strong { color: #fff; }
  .escuro .detalhe { color: #b9c0cf; }
  .escuro .avatar { color: var(--navy); }
  .escuro .completo { color: #d8dce6; }
</style>
