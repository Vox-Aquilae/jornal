---
interface Props { titulo: string }
const { titulo } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const wa = `https://wa.me/?text=${encodeURIComponent(`${titulo} — Vox Aquilae\n${url}`)}`;
const mail = `mailto:?subject=${encodeURIComponent(titulo + ' — Vox Aquilae')}&body=${encodeURIComponent(url)}`;
---
<div class="partilha" data-partilha data-titulo={titulo}>
  <span class="rotulo">Partilhar</span>
  <a class="botao cheio" data-wa href={wa} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"></path></svg>
    WhatsApp
  </a>
  <a class="botao" data-mail href={mail}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
    Email
  </a>
  <button class="botao" type="button" data-copiar>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
    <span>Copiar ligação</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-partilha]').forEach((el) => {
    const titulo = el.dataset.titulo ?? '';
    const url = location.href.split('#')[0];
    const wa = el.querySelector<HTMLAnchorElement>('[data-wa]');
    const mail = el.querySelector<HTMLAnchorElement>('[data-mail]');
    if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(`${titulo} — Vox Aquilae\n${url}`)}`;
    if (mail) mail.href = `mailto:?subject=${encodeURIComponent(titulo + ' — Vox Aquilae')}&body=${encodeURIComponent(url)}`;
    const btn = el.querySelector<HTMLButtonElement>('[data-copiar]');
    btn?.addEventListener('click', async () => {
      const span = btn.querySelector('span')!;
      try { await navigator.clipboard.writeText(url); span.textContent = 'Ligação copiada'; }
      catch { span.textContent = 'Copie da barra de endereço'; }
      setTimeout(() => (span.textContent = 'Copiar ligação'), 2500);
    });
  });
</script>

<style>
  .partilha { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .rotulo { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--suave); margin-right: 6px; }
  .botao { min-height: 44px; padding: 0 18px; font-size: 14.5px; }
</style>
