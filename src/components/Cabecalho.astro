---
import Logo from './Logo.astro';
import { u, site, disciplinasComPosts, temValor } from '../lib/site';
interface Props { ativa?: string }
const { ativa } = Astro.props;
const disciplinas = await disciplinasComPosts();
---
<header class="cabecalho">
  <div class="contentor topo">
    <a href={u('/')} class="marca" aria-label="Vox Aquilae — página inicial"><Logo assinatura={false} /></a>
    <p class="descritor">Jornal do Colégio Planalto</p>
    {temValor(site.site_colegio) && <a class="colegio" href={site.site_colegio} rel="noopener">Site do colégio ↗</a>}
  </div>
  <nav class="disciplinas" aria-label="Disciplinas">
    <ul class="contentor">
      <li><a href={u('/')} aria-current={!ativa ? 'page' : undefined}>Tudo</a></li>
      {disciplinas.map(([id, nome]) => (
        <li><a href={u(`/disciplina/${id}/`)} aria-current={ativa === id ? 'page' : undefined}>{nome}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .cabecalho { border-bottom: 1px solid var(--filete); }
  .topo { display: flex; align-items: center; gap: 20px; padding-top: 18px; padding-bottom: 14px; border-bottom: 4px solid var(--vermelho); }
  .marca { display: block; width: 150px; flex: none; color: var(--azul); }
  .descritor { margin: 0; padding-left: 20px; border-left: 1px solid var(--filete); font-size: 14px; font-weight: 600; letter-spacing: .04em; color: var(--azul); }
  .colegio { margin-left: auto; font-size: 14px; font-weight: 600; color: var(--azul); text-decoration: none; white-space: nowrap; }
  .colegio:hover { color: var(--vermelho-texto); }
  .disciplinas ul { list-style: none; margin: 0 auto; display: flex; gap: 4px 24px; overflow-x: auto; scrollbar-width: none; }
  .disciplinas ul::-webkit-scrollbar { display: none; }
  .disciplinas li { flex: none; }
  .disciplinas a {
    display: inline-flex; align-items: center; min-height: 48px; font-size: 14.5px; font-weight: 600; color: var(--suave);
    text-decoration: none; border-bottom: 3px solid transparent; margin-bottom: -1px;
  }
  .disciplinas a:hover { color: var(--azul); }
  .disciplinas a[aria-current='page'] { color: var(--azul); border-bottom-color: var(--azul); }
  @media (max-width: 620px) {
    .marca { width: 118px; }
    .descritor { display: none; }
  }
</style>
