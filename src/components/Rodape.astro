---
import Logo from './Logo.astro';
import { u, site, temValor } from '../lib/site';
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="contentor linha">
    <a href={u('/')} class="marca" aria-label="Vox Aquilae — página inicial"><Logo /></a>
    <ul>
      {temValor(site.site_colegio) && <li><a href={site.site_colegio} rel="noopener">Colégio Planalto</a></li>}
      <li><a href={u('/rss.xml')}>RSS</a></li>
    </ul>
  </div>
  <div class="contentor base">
    <span>© {ano} Vox Aquilae · Colégio Planalto</span>
    <span>Só publicamos imagens de alunos com autorização das famílias.</span>
  </div>
</footer>

<style>
  .rodape { background: var(--azul); color: #cfd6e4; margin-top: 72px; }
  .rodape a { color: #fff; text-decoration: none; }
  .rodape a:hover { text-decoration: underline; text-decoration-color: #ff8a9b; }
  .linha { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-top: 40px; padding-bottom: 28px; }
  .marca { width: 240px; color: #fff; --vermelho: #ff6b80; --vermelho-texto: #ff9aa9; }
  .marca :global(.logo) { color: #fff; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; font-weight: 600; font-size: 15px; }
  .base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 24px; border-top: 1px solid rgba(255,255,255,.15); padding-top: 16px; padding-bottom: 24px; font-size: 13px; color: #aab4c8; }
</style>
