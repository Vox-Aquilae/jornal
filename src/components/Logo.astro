---
import { EMBLEMA } from '../lib/emblem';
interface Props { assinatura?: boolean; class?: string; titulo?: string }
const { assinatura = true, class: cls = '', titulo = 'Vox Aquilae' } = Astro.props;
const h = assinatura ? 340 : 312;
---
<svg class={`logo ${cls}`} viewBox={`0 0 760 ${h}`} role="img" aria-label={titulo}>
  <text x="140" y="290" text-anchor="middle" class="logo-letra">V</text>
  <g transform="translate(270.1 75.1) scale(1.0825)"><path d={EMBLEMA} fill="currentColor"></path></g>
  <path d="M418.3,67.1 A124,124 0 0 1 494.9,138.5" class="logo-arco"></path>
  <path d="M433.2,53.4 A142,142 0 0 1 503,114" class="logo-arco" opacity="0.6"></path>
  <text x="622" y="290" text-anchor="middle" class="logo-letra">X</text>
  <text x="203" y="289" class="logo-aquilae">AQUILAE</text>
  {assinatura && <text x="742" y="330" text-anchor="end" class="logo-assinatura">JORNAL DO COLÉGIO PLANALTO · FUNDADO EM 2013</text>}
</svg>

<style>
  .logo { display: block; width: 100%; height: auto; color: var(--navy); overflow: visible; }
  .logo-letra { font-family: var(--serif); font-size: 300px; font-weight: 500; fill: currentColor; font-variation-settings: 'opsz' 28; }
  .logo-aquilae { font-variation-settings: 'opsz' 14; }
  .logo-aquilae { font-family: var(--serif); font-size: 27px; font-weight: 500; letter-spacing: 3.5px; fill: currentColor; }
  .logo-assinatura { font-family: var(--sans); font-size: 12.5px; font-weight: 600; letter-spacing: 2.6px; fill: var(--gold-texto); }
  .logo-arco { fill: none; stroke: var(--gold); stroke-width: 4.5; stroke-linecap: round; }
</style>
