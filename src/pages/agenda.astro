---
import Base from '../layouts/Base.astro';
import { u, agendaOrdenada, dia, mesAbrev, fmtMesAno, temValor } from '../lib/site';
const eventos = await agendaOrdenada();
const porMes = new Map<string, typeof eventos>();
for (const e of eventos) {
  const k = fmtMesAno(e.data.data);
  porMes.set(k, [...(porMes.get(k) ?? []), e]);
}
---
<Base titulo="Agenda" descricao="Próximos eventos do Colégio Planalto para alunos e famílias.">
  <div class="contentor seccao-pagina">
    <header class="cabecalho-pagina">
      <span class="kicker">Agenda</span>
      <h1>O que aí vem</h1>
      <p>Eventos, prazos e celebrações do colégio. Os eventos já realizados ficam no fim da página.</p>
    </header>

    {eventos.length === 0 && <p class="vazio">Sem eventos na agenda.</p>}

    <div data-agenda>
      {[...porMes.entries()].map(([mes, lista]) => (
        <section class="mes" data-mes>
          <h2>{mes}</h2>
          <ol>
            {lista.map((e) => (
              <li data-data={e.data.data.toISOString().slice(0, 10)}>
                <div class="data-bloco"><span class="d">{dia(e.data.data)}</span><span class="m">{mesAbrev(e.data.data)}</span></div>
                <div class="texto">
                  <h3>{e.data.titulo} {e.data.exemplo && <span class="selo-exemplo">Exemplo</span>}</h3>
                  <p class="meta">
                    {temValor(e.data.hora) && <span>{e.data.hora}</span>}
                    {temValor(e.data.local) && <span>{e.data.local}</span>}
                    <span>Para: {e.data.publico}</span>
                  </p>
                  {temValor(e.data.descricao) && <p class="descricao">{e.data.descricao}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <details class="passados" data-passados hidden>
      <summary>Eventos já realizados</summary>
      <ol data-lista-passados></ol>
    </details>
  </div>
</Base>

<script>
  // Move os eventos passados para o fim, mesmo que o site não tenha sido republicado.
  const hoje = new Date().toISOString().slice(0, 10);
  const lista = document.querySelector('[data-lista-passados]');
  const caixa = document.querySelector<HTMLElement>('[data-passados]');
  const passados = [...document.querySelectorAll<HTMLElement>('[data-agenda] li[data-data]')].filter((li) => (li.dataset.data ?? '') < hoje);
  passados.reverse().forEach((li) => lista?.appendChild(li));
  if (passados.length && caixa) caixa.hidden = false;
  document.querySelectorAll<HTMLElement>('[data-mes]').forEach((m) => { if (!m.querySelector('li')) m.remove(); });
</script>

<style>
  .mes { margin-bottom: 40px; }
  .mes h2 { font-size: 28px; color: var(--navy); border-top: 3px solid var(--navy); padding-top: 12px; margin-bottom: 8px; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--rule); }
  h3 { font-size: 23px; color: var(--navy); margin-bottom: 6px; }
  .meta { margin: 0; }
  .descricao { margin: 10px 0 0; max-width: 64ch; color: #3b4150; }
  .data-bloco { flex: none; width: 70px; text-align: center; border: 1.5px solid var(--navy); border-radius: var(--raio); padding: 8px 0 6px; color: var(--navy); align-self: flex-start; }
  .data-bloco .d { display: block; font-family: var(--serif); font-size: 30px; font-weight: 600; line-height: 1; }
  .data-bloco .m { display: block; font-size: 11px; font-weight: 700; letter-spacing: .12em; color: var(--gold-texto); margin-top: 4px; }
  .passados { margin-top: 24px; }
  .passados summary { cursor: pointer; font-weight: 600; color: var(--navy); min-height: 44px; display: flex; align-items: center; }
  .passados li { opacity: .7; }
</style>
