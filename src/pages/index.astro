---
import Base from '../layouts/Base.astro';
import CartaoNoticia from '../components/CartaoNoticia.astro';
import CartaoVoz from '../components/CartaoVoz.astro';
import Capa from '../components/Capa.astro';
import Emblema from '../components/Emblema.astro';
import { u, site, noticiasPublicadas, vozesOrdenadas, agendaOrdenada, galeriasOrdenadas, dia, mesAbrev, fmtData, temValor } from '../lib/site';

const noticias = await noticiasPublicadas();
const manchete = noticias.find((n) => n.data.destaque) ?? noticias[0];
const resto = noticias.filter((n) => n !== manchete);
const laterais = resto.slice(0, 3);
const ultimas = resto.slice(3, 9);

const vozes = await vozesOrdenadas();
const vozesCapa = [...vozes.filter((v) => v.data.destaque), ...vozes.filter((v) => !v.data.destaque)].slice(0, 3);

const hoje = new Date(new Date().toISOString().slice(0, 10));
const agenda = (await agendaOrdenada()).filter((a) => a.data.data >= hoje).slice(0, 4);
const galeria = (await galeriasOrdenadas())[0];
const temCanais = temValor(site.canal_whatsapp) || temValor(site.newsletter);
---
<Base masthead>
  <div class="contentor">
    {manchete ? (
      <section class="abertura" aria-label="Destaques">
        <div class="principal"><CartaoNoticia n={manchete} variante="manchete" prioridade /></div>
        <div class="lateral">
          <h2 class="sr-only">Também em destaque</h2>
          {laterais.map((n) => <CartaoNoticia n={n} variante="lista" />)}
          <a class="botao secundario todas" href={u('/noticias/')}>Todas as notícias</a>
        </div>
      </section>
    ) : (
      <p class="vazio">Ainda não há notícias publicadas.</p>
    )}

    {ultimas.length > 0 && (
      <section class="bloco" aria-labelledby="t-ultimas">
        <div class="titulo-bloco"><h2 id="t-ultimas">Últimas</h2><a href={u('/noticias/')}>Ver todas</a></div>
        <div class="grelha-3">
          {ultimas.map((n) => <CartaoNoticia n={n} />)}
        </div>
      </section>
    )}
  </div>

  {vozesCapa.length > 0 && (
    <section class="faixa-vozes" aria-labelledby="t-vozes">
      <div class="contentor">
        <div class="vozes-cabeca">
          <div>
            <span class="kicker claro">Vozes do Planalto</span>
            <h2 id="t-vozes">O que dizem alunos, famílias e professores</h2>
          </div>
          <div class="vozes-acoes">
            <a class="botao ouro" href={u('/participar/')}>Partilhar o meu testemunho</a>
            <a class="ligacao-clara" href={u('/vozes/')}>Ver todas as vozes →</a>
          </div>
        </div>
        <div class="grelha-3">
          {vozesCapa.map((v) => <CartaoVoz v={v} escuro />)}
        </div>
      </div>
    </section>
  )}

  <div class="contentor">
    <div class="duas-colunas bloco">
      <section aria-labelledby="t-agenda">
        <div class="titulo-bloco"><h2 id="t-agenda">Agenda</h2><a href={u('/agenda/')}>Agenda completa</a></div>
        {agenda.length ? (
          <ol class="agenda">
            {agenda.map((a) => (
              <li>
                <div class="data-bloco"><span class="d">{dia(a.data.data)}</span><span class="m">{mesAbrev(a.data.data)}</span></div>
                <div>
                  <h3>{a.data.titulo} {a.data.exemplo && <span class="selo-exemplo">Exemplo</span>}</h3>
                  <p class="meta">
                    {temValor(a.data.hora) && <span>{a.data.hora}</span>}
                    {temValor(a.data.local) && <span>{a.data.local}</span>}
                    <span>{a.data.publico}</span>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        ) : <p class="vazio">Sem eventos marcados para os próximos dias.</p>}
      </section>

      {galeria && (
        <section aria-labelledby="t-galeria">
          <div class="titulo-bloco"><h2 id="t-galeria">Galeria</h2><a href={u('/galeria/')}>Todas as galerias</a></div>
          <a class="album" href={u(`/galeria/${galeria.id}/`)}>
            <div class="mosaico">
              {(galeria.data.fotos.length ? galeria.data.fotos.slice(0, 3) : [{ imagem: galeria.data.capa ?? '', legenda: '' }]).map((f, i) => (
                <div class={`m m${i}`}><Capa imagem={f.imagem} alt={f.legenda} seccao="cultura" proporcao={i === 0 ? '4 / 3' : '1 / 1'} /></div>
              ))}
            </div>
            <h3>{galeria.data.titulo} {galeria.data.exemplo && <span class="selo-exemplo">Exemplo</span>}</h3>
            <p class="meta"><span>{fmtData(galeria.data.data)}</span><span>{galeria.data.fotos.length} fotografias</span></p>
          </a>
        </section>
      )}
    </div>
  </div>

  <section class="contentor" aria-labelledby="t-receber">
    <div class="receber">
      <Emblema class="receber-emblema" />
      <div class="receber-texto">
        <h2 id="t-receber">Receba o Vox Aquilae</h2>
        <p>As notícias do colégio, sem ter de as procurar. Escolha o canal que lhe dá mais jeito.</p>
      </div>
      <div class="receber-acoes">
        {temValor(site.canal_whatsapp) && <a class="botao ouro" href={site.canal_whatsapp} rel="noopener">Seguir no WhatsApp</a>}
        {temValor(site.newsletter) && <a class="botao secundario claro" href={site.newsletter} rel="noopener">Newsletter por email</a>}
        {!temCanais && <a class="botao ouro" href={u('/participar/')}>Como acompanhar e participar</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .abertura { display: grid; grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr); gap: 48px; padding: 40px 0 56px; }
  .lateral { display: flex; flex-direction: column; border-left: 1px solid var(--rule); padding-left: 40px; }
  .todas { margin-top: auto; align-self: flex-start; }
  .bloco { padding: 8px 0 64px; }
  .grelha-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 32px; }

  .faixa-vozes { background: var(--navy); color: #fff; padding: 64px 0 72px; margin-bottom: 64px; position: relative; overflow: hidden; }
  .vozes-cabeca { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .vozes-cabeca h2 { color: #fff; font-size: clamp(30px, 3.6vw, 44px); max-width: 18ch; margin-top: 10px; }
  .kicker.claro { color: var(--gold-claro); }
  .vozes-acoes { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .ligacao-clara { color: #fff; font-weight: 600; text-decoration: none; }
  .ligacao-clara:hover { color: var(--gold-claro); }

  .duas-colunas { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
  .agenda { list-style: none; margin: 0; padding: 0; }
  .agenda li { display: flex; gap: 20px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .agenda li:first-child { padding-top: 0; }
  .agenda h3 { font-size: 21px; color: var(--navy); margin-bottom: 6px; }
  .agenda .meta { margin: 0; }
  .data-bloco { flex: none; width: 64px; text-align: center; border: 1.5px solid var(--navy); border-radius: var(--raio); padding: 6px 0 4px; color: var(--navy); }
  .data-bloco .d { display: block; font-family: var(--serif); font-size: 28px; font-weight: 600; line-height: 1; }
  .data-bloco .m { display: block; font-size: 11px; font-weight: 700; letter-spacing: .12em; color: var(--gold-texto); margin-top: 4px; }

  .album { display: block; text-decoration: none; }
  .album h3 { font-size: 22px; color: var(--navy); margin: 16px 0 6px; }
  .album:hover h3 { text-decoration: underline; }
  .mosaico { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 8px; }
  .m0 { grid-row: 1 / 3; }
  .m0 :global(.capa) { height: 100%; aspect-ratio: auto !important; }

  .receber {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 32px;
    background: var(--paper-2); border: 1px solid var(--rule); border-radius: 8px; padding: 36px 40px; margin-bottom: 40px;
  }
  .receber :global(.receber-emblema) { width: 88px; color: var(--navy); }
  .receber h2 { font-size: 30px; color: var(--navy); margin-bottom: 6px; }
  .receber p { margin: 0; color: var(--muted); }
  .receber-acoes { display: flex; gap: 12px; flex-wrap: wrap; }
  .receber .botao.ouro { background: var(--navy); border-color: var(--navy); color: #fff; }

  @media (max-width: 980px) {
    .abertura { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-top: 28px; }
    .lateral { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 24px; }
    .lateral :global(.lista:first-of-type) { border-top: 0; }
    .grelha-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .duas-colunas { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .receber { grid-template-columns: minmax(0, 1fr); text-align: left; padding: 28px 24px; gap: 18px; }
    .receber :global(.receber-emblema) { width: 64px; }
  }
  @media (max-width: 640px) {
    .grelha-3 { grid-template-columns: minmax(0, 1fr); }
  }
</style>
