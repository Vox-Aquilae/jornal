---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Capa from '../../components/Capa.astro';
import Partilha from '../../components/Partilha.astro';
import CartaoNoticia from '../../components/CartaoNoticia.astro';
import { u, fmtData, noticiasPublicadas, tempoLeitura, temValor, nomeDisciplina, slug } from '../../lib/site';

export async function getStaticPaths() {
  const todas = await noticiasPublicadas();
  return todas.map((n) => ({ params: { id: n.id }, props: { n } }));
}
const { n } = Astro.props;
const d = n.data;
const { Content } = await render(n);
const disc = nomeDisciplina(d.disciplina);
const relacionadas = (await noticiasPublicadas())
  .filter((x) => x.id !== n.id)
  .sort((a, b) => Number(b.data.disciplina === d.disciplina) - Number(a.data.disciplina === d.disciplina))
  .slice(0, 3);
---
<Base titulo={d.titulo} descricao={d.resumo} imagem={d.imagem} tipo="article" ativa={d.disciplina}>
  <article class="contentor artigo">
    <header class="cabeca">
      <div class="sobre">
        <a class="etiqueta" href={u(`/disciplina/${d.disciplina}/`)}>{disc}</a>
        {temValor(d.turmas) && <span class="turmas">{d.turmas}</span>}
        {d.exemplo && <span class="selo-exemplo">Exemplo</span>}
      </div>
      <h1>{d.titulo}</h1>
      <p class="resumo">{d.resumo}</p>
      <p class="meta">
        <a href={u(`/professor/${slug(d.professor)}/`)}>{d.professor}</a>
        <time datetime={d.data.toISOString().slice(0, 10)}>{fmtData(d.data)}</time>
        <span>{tempoLeitura(n.body)} min de leitura</span>
      </p>
    </header>

    <figure class="imagem">
      <Capa imagem={d.imagem} alt={d.legenda} rotulo={disc} proporcao="16 / 8" prioridade />
      {temValor(d.legenda) && <figcaption>{d.legenda}</figcaption>}
    </figure>

    <div class="prosa corpo"><Content /></div>
    <div class="partilhar"><Partilha titulo={d.titulo} /></div>
  </article>

  {relacionadas.length > 0 && (
    <section class="contentor mais" aria-labelledby="t-mais">
      <h2 id="t-mais">Mais publicações</h2>
      <div class="grelha">{relacionadas.map((x) => <CartaoNoticia n={x} />)}</div>
    </section>
  )}
</Base>

<style>
  .artigo { padding-top: 44px; }
  .cabeca { max-width: 780px; margin: 0 auto 32px; }
  .sobre { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; margin-bottom: 14px; }
  .turmas { font-size: 13px; color: var(--suave); }
  h1 { font-size: clamp(34px, 5.2vw, 56px); line-height: 1.05; }
  .resumo { font-size: clamp(18px, 2vw, 21px); line-height: 1.45; color: #3b4252; margin: 18px 0 16px; }
  .imagem { margin: 0 auto 40px; max-width: 1000px; }
  .imagem figcaption { font-size: 14px; color: var(--suave); margin-top: 10px; }
  .corpo { margin: 0 auto; max-width: 720px; }
  .partilhar { max-width: 720px; margin: 40px auto 0; padding-top: 24px; border-top: 1px solid var(--filete); }
  .mais { padding-top: 64px; }
  .mais h2 { font-size: 26px; padding-top: 14px; border-top: 3px solid var(--azul); margin-bottom: 28px; }
</style>
