---
import Base from '../../layouts/Base.astro';
import CartaoNoticia from '../../components/CartaoNoticia.astro';
import { u, SECCOES, noticiasPublicadas } from '../../lib/site';
const noticias = await noticiasPublicadas();
---
<Base titulo="Notícias" descricao="Todas as notícias do Vox Aquilae, o jornal do Colégio Planalto.">
  <div class="contentor seccao-pagina">
    <header class="cabecalho-pagina">
      <span class="kicker">Vox Aquilae</span>
      <h1>Notícias</h1>
      <p>Tudo o que acontece no Planalto, contado por quem lá está.</p>
    </header>
    <nav class="chips filtros" aria-label="Filtrar por secção">
      <a class="chip" href={u('/noticias/')} aria-current="page">Todas</a>
      {Object.entries(SECCOES).map(([id, s]) => <a class="chip" href={u(`/seccao/${id}/`)}>{s.nome}</a>)}
    </nav>
    {noticias.length ? (
      <div class="grelha">{noticias.map((n, i) => <CartaoNoticia n={n} prioridade={i < 3} />)}</div>
    ) : <p class="vazio">Ainda não há notícias publicadas.</p>}
  </div>
</Base>

<style>
  .filtros { margin-bottom: 40px; }
  .grelha { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 32px; }
  @media (max-width: 980px) { .grelha { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grelha { grid-template-columns: minmax(0, 1fr); } }
</style>
