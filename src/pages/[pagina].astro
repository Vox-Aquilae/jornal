---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { u, site, temValor } from '../lib/site';

export async function getStaticPaths() {
  return (await getCollection('paginas')).map((p) => ({ params: { pagina: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const participar = p.id === 'participar';
---
<Base titulo={p.data.titulo} descricao={p.data.resumo ?? undefined}>
  <div class="contentor seccao-pagina">
    <header class="cabecalho-pagina">
      <span class="kicker">Vox Aquilae</span>
      <h1>{p.data.titulo}</h1>
      {temValor(p.data.resumo) && <p>{p.data.resumo}</p>}
    </header>
    <div class="corpo">
      <div class="prosa sem-capitular"><Content /></div>
      {participar && (
        <aside class="cartao-acao">
          <h2>Enviar um testemunho</h2>
          <p>Alunos, pais e professores podem enviar o seu testemunho através do formulário. A redação revê cada texto antes de o publicar.</p>
          {temValor(site.formulario_testemunhos)
            ? <a class="botao" href={site.formulario_testemunhos} rel="noopener">Abrir o formulário</a>
            : <p class="nota">O formulário fica disponível aqui assim que a redação o configurar.</p>}
          {temValor(site.email_redacao) && <p class="nota">Ou escreva para <a href={`mailto:${site.email_redacao}`}>{site.email_redacao}</a>.</p>}
          <hr />
          <h2>Acompanhar o jornal</h2>
          <div class="acoes">
            {temValor(site.canal_whatsapp) && <a class="botao ouro" href={site.canal_whatsapp} rel="noopener">Canal de WhatsApp</a>}
            {temValor(site.newsletter) && <a class="botao secundario" href={site.newsletter} rel="noopener">Newsletter por email</a>}
            <a class="botao secundario" href={u('/rss.xml')}>RSS</a>
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>

<style>
  .corpo { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 56px; align-items: start; }
  .corpo:not(:has(aside)) { grid-template-columns: minmax(0, 1fr); }
  .cartao-acao { background: #fff; border: 1px solid var(--rule); border-top: 4px solid var(--gold); border-radius: 6px; padding: 28px; position: sticky; top: 24px; }
  .cartao-acao h2 { font-size: 24px; color: var(--navy); margin-bottom: 10px; }
  .cartao-acao p { font-size: 15.5px; color: #3b4150; }
  .nota { font-size: 14px !important; color: var(--muted) !important; }
  hr { border: 0; border-top: 1px solid var(--rule); margin: 24px 0; }
  .acoes { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 900px) { .corpo { grid-template-columns: minmax(0, 1fr); } .cartao-acao { position: static; } }
</style>
