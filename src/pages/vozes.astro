---
import Base from '../layouts/Base.astro';
import CartaoVoz from '../components/CartaoVoz.astro';
import { u, PAPEIS, vozesOrdenadas } from '../lib/site';
const vozes = await vozesOrdenadas();
const contagem = (p: string) => vozes.filter((v) => v.data.papel === p).length;
---
<Base titulo="Vozes" descricao="Testemunhos de alunos, famílias e professores do Colégio Planalto.">
  <div class="contentor seccao-pagina">
    <header class="cabecalho-pagina">
      <span class="kicker">Vozes do Planalto</span>
      <h1>O que dizem alunos, famílias e professores</h1>
      <p>Testemunhos sobre a vida do colégio, na primeira pessoa. Todos passam pela redação antes de serem publicados.</p>
    </header>

    <div class="barra">
      <div class="chips" role="group" aria-label="Filtrar testemunhos">
        <button class="chip" type="button" data-filtro="todos" aria-pressed="true">Todos ({vozes.length})</button>
        {Object.entries(PAPEIS).filter(([id]) => contagem(id) > 0).map(([id, p]) => (
          <button class="chip" type="button" data-filtro={id} aria-pressed="false">{p.plural} ({contagem(id)})</button>
        ))}
      </div>
      <a class="botao" href={u('/participar/')}>Partilhar o meu testemunho</a>
    </div>

    {vozes.length ? (
      <div class="grelha" data-vozes>
        {vozes.map((v) => <div class="item" data-papel={v.data.papel}><CartaoVoz v={v} /></div>)}
      </div>
    ) : <p class="vazio">Ainda não há testemunhos publicados.</p>}
  </div>
</Base>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const itens = document.querySelectorAll<HTMLElement>('[data-vozes] .item');
  botoes.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro;
      botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      itens.forEach((i) => (i.hidden = f !== 'todos' && i.dataset.papel !== f));
    })
  );
</script>

<style>
  .barra { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 36px; }
  .grelha { columns: 3 320px; column-gap: 28px; }
  .item { break-inside: avoid; margin-bottom: 28px; }
  .item[hidden] { display: none; }
</style>
