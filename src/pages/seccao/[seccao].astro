---
import Base from '../../layouts/Base.astro';
import CartaoNoticia from '../../components/CartaoNoticia.astro';
import { u, SECCOES, noticiasPublicadas } from '../../lib/site';

export function getStaticPaths() {
  return Object.keys(SECCOES).map((seccao) => ({ params: { seccao } }));
}
const { seccao } = Astro.params;
const s = SECCOES[seccao!];
const noticias = (await noticiasPublicadas()).filter((n) => n.data.seccao === seccao);
---
<Base titulo={s.nome} descricao={s.descricao}>
  <div class="contentor seccao-pagina">
    <header class="cabecalho-pagina" style={`--cor: ${s.cor}`}>
      <span class="kicker">Secção</span>
      <h1>{s.nome}</h1>
      <p>{s.descricao}</p>
    </header>
    <nav class="chips filtros" aria-label="Filtrar por secção">
      <a class="chip" href={u('/noticias/')}>Todas</a>
      {Object.entries(SECCOES).map(([id, x]) => <a class="chip" href={u(`/seccao/${id}/`)} aria-current={id === seccao ? 'page' : undefined}>{x.nome}</a>)}
    </nav>
    {noticias.length ? (
      <div class="grelha">{noticias.map((n, i) => <CartaoNoticia n={n} prioridade={i < 3} />)}</div>
    ) : (
      <div class="vazio">
        <p>Ainda não há artigos em {s.nome}.</p>
        <a class="botao secundario" href={u('/participar/')}>Quer escrever para esta secção?</a>
      </div>
    )}
  </div>
</Base>

<style>
  .cabecalho-pagina h1 { color: var(--cor); }
  .filtros { margin-bottom: 40px; }
  .grelha { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 32px; }
  @media (max-width: 980px) { .grelha { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grelha { grid-template-columns: minmax(0, 1fr); } }
</style>
