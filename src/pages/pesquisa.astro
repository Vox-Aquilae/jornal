---
import Base from '../layouts/Base.astro';
import { u, SECCOES, fmtData, noticiasPublicadas, vozesOrdenadas, PAPEIS } from '../lib/site';
const noticias = await noticiasPublicadas();
const vozes = await vozesOrdenadas();
const indice = [
  ...noticias.map((n) => ({
    t: n.data.titulo, r: n.data.resumo, k: SECCOES[n.data.seccao].nome, d: fmtData(n.data.data),
    x: (n.body ?? '').slice(0, 4000), h: u(`/noticias/${n.id}/`),
  })),
  ...vozes.map((v) => ({
    t: `«${v.data.citacao}»`, r: `${v.data.nome}${v.data.detalhe ? ', ' + v.data.detalhe : ''}`, k: `Vozes · ${PAPEIS[v.data.papel].nome}`,
    d: fmtData(v.data.data), x: v.body ?? '', h: u('/vozes/'),
  })),
];
---
<Base titulo="Pesquisa" descricao="Pesquisar notícias e testemunhos no Vox Aquilae.">
  <div class="contentor seccao-pagina">
    <header class="cabecalho-pagina">
      <span class="kicker">Pesquisa</span>
      <h1>Procurar no jornal</h1>
    </header>
    <form class="caixa-pesquisa" role="search" onsubmit="return false">
      <label for="q" class="sr-only">Pesquisar</label>
      <input id="q" type="search" placeholder="Ex.: oratória, fotografia, 9.º ano…" autocomplete="off" />
    </form>
    <p class="estado" aria-live="polite" data-estado>Escreva pelo menos duas letras.</p>
    <ol class="resultados" data-resultados></ol>
  </div>
  <script type="application/json" id="indice" set:html={JSON.stringify(indice).replace(/</g, '\\u003c')}></script>
</Base>

<script>
  type Item = { t: string; r: string; k: string; d: string; x: string; h: string };
  const indice: Item[] = JSON.parse(document.getElementById('indice')!.textContent || '[]');
  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const prep = indice.map((i) => ({ i, txt: norm(`${i.t} ${i.r} ${i.k} ${i.x}`), tit: norm(i.t) }));
  const input = document.getElementById('q') as HTMLInputElement;
  const lista = document.querySelector('[data-resultados]')!;
  const estado = document.querySelector('[data-estado]')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function pesquisar() {
    const q = norm(input.value.trim());
    lista.innerHTML = '';
    if (q.length < 2) { estado.textContent = 'Escreva pelo menos duas letras.'; return; }
    const termos = q.split(/\s+/);
    const res = prep
      .filter((p) => termos.every((t) => p.txt.includes(t)))
      .sort((a, b) => Number(termos.some((t) => b.tit.includes(t))) - Number(termos.some((t) => a.tit.includes(t))));
    estado.textContent = res.length ? `${res.length} resultado${res.length > 1 ? 's' : ''}` : 'Sem resultados. Experimente outras palavras.';
    for (const { i } of res) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="kicker">${esc(i.k)}</span><h2><a href="${i.h}">${esc(i.t)}</a></h2><p>${esc(i.r)}</p><span class="meta">${esc(i.d)}</span>`;
      lista.appendChild(li);
    }
  }
  input.addEventListener('input', pesquisar);
  const inicial = new URLSearchParams(location.search).get('q');
  if (inicial) { input.value = inicial; pesquisar(); }
  input.focus();
</script>

<style>
  .caixa-pesquisa input {
    width: 100%; max-width: 720px; min-height: 60px; padding: 0 22px; font: inherit; font-size: 20px; color: var(--ink);
    border: 2px solid var(--navy); border-radius: 999px; background: #fff;
  }
  .estado { color: var(--muted); margin: 18px 0 8px; }
  .resultados { list-style: none; padding: 0; margin: 0; max-width: 820px; }
  .resultados :global(li) { padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .resultados :global(h2) { font-size: 24px; color: var(--navy); margin: 6px 0 8px; }
  .resultados :global(h2 a) { text-decoration: none; }
  .resultados :global(h2 a:hover) { text-decoration: underline; }
  .resultados :global(p) { margin: 0 0 6px; color: #3b4150; }
</style>
