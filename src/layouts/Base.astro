---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { u, site } from '../lib/site';

interface Props { titulo?: string; descricao?: string; imagem?: string | null; ativa?: string; tipo?: 'website' | 'article' }
const { titulo, descricao = site.descricao, imagem, ativa, tipo = 'website' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} — Vox Aquilae` : 'Vox Aquilae — Jornal do Colégio Planalto';
const urlCanonico = new URL(Astro.url.pathname, Astro.site);
const imagemOg = new URL(imagem && imagem.trim() ? u(imagem) : u('/og-vox-aquilae.png'), Astro.site);
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={urlCanonico} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
  <link rel="alternate" type="application/rss+xml" title="Vox Aquilae" href={u('/rss.xml')} />
  <meta name="theme-color" content="#14284B" />
  <meta property="og:site_name" content="Vox Aquilae" />
  <meta property="og:locale" content="pt_PT" />
  <meta property="og:type" content={tipo} />
  <meta property="og:title" content={titulo ?? 'Vox Aquilae'} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={urlCanonico} />
  <meta property="og:image" content={imagemOg} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <a class="salto" href="#conteudo">Saltar para o conteúdo</a>
  <Cabecalho ativa={ativa} />
  <main id="conteudo">
    <slot />
  </main>
  <Rodape />
</body>
</html>
